QWidget {
    background-color: #e7e2d3;
    color: #2f2b24;
    font-size: 10pt;
}

/* Main Window */
QMainWindow {
    background-color: #e7e2d3;
}

/* Navigation */
QListWidget {
    background-color: #d6cfbf;
    border-right: 1px solid #8b8067;
    padding: 4px;
}

QListWidget::item {
    padding: 8px;
    margin: 2px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #556b2f;
    color: white;
}

QListWidget::item:hover {
    background-color: #c7bea8;
}

/* Labels */
QLabel {
    color: #3f3a30;
}

/* Small connection-status label (server/database), shown top-right
   on widgets that need it. Uses the same olive accent as
   QGroupBox::title for a consistent "secondary info" look. */
QLabel#connectionInfoLabel {
    color: #556b2f;
    font-size: 8pt;
}

/* Status Bar */
QStatusBar {
    background-color: #d6cfbf;
    border-top: 1px solid #8b8067;
}

/* Splitter */
QSplitter::handle {
    background-color: #8b8067;
    width: 2px;
}

/* Main workspace panels */

QFrame,
QWidget {
    background-color: #e7e2d3;
}

/* Menu and status styling */

QStatusBar {
    background-color: #d6cfbf;
    color: #2f2b24;
}

/* Table styling */

QTableView {
    background-color: #f4f1e8;
    alternate-background-color: #e7e2d3;
    gridline-color: #b7aa8c;
    selection-background-color: #556b2f;
    selection-color: white;
    border: 1px solid #8b8067;
}

QTableView::item:selected {
    background-color: #6b8e23;
    color: white;
}

QHeaderView::section {
    background-color: #c7bea8;
    color: #2f2b24;
    padding: 4px;
    border: 1px solid #8b8067;
    font-weight: bold;
}

/* Scrollbars */

QScrollBar:vertical {
    background: #d6cfbf;
    width: 14px;
}

QScrollBar::handle:vertical {
    background: #8b8067;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar:horizontal {
    background: #d6cfbf;
    height: 14px;
}

QScrollBar::handle:horizontal {
    background: #8b8067;
    min-width: 20px;
    border-radius: 4px;
}

/* Form widgets: */
QLineEdit,
QTextEdit,
QDateEdit,
QComboBox
{
    background-color: #f5f5f0;
    border: 1px solid #7a7a6a;
    border-radius: 3px;
    padding: 4px;
}

/* Give the focused widget a border and bg color: */
QLineEdit:focus,
QTextEdit:focus,
QComboBox:focus,
QDateEdit:focus {

    border: 2px solid #6A8A6B;
    background-color: #2D3A2D;
    color: #F0F0F0;
}

/* This is the 'mask' for date fields mainly.
   When the widget gets focus, the placeholder text must be visible.
   See function 'create_date_edit()', which does this in Python for more reliability.
 */
QLineEdit::placeholder {
    color: #A0B0A0;
}

/* Buttons */
QPushButton {
    background-color: #c7bea8;
    color: #2f2b24;
    border: 1px solid #8b8067;
    border-radius: 3px;
    padding: 5px 12px;
    font-weight: bold;

    /* 3D shadow effect */
    border-top-color: #ddd8c4;
    border-left-color: #ddd8c4;
    border-bottom-color: #6b6050;
    border-right-color: #6b6050;
}

QPushButton:hover {
    background-color: #c7bea8;
    color: #2f2b24;
    border-top-color: #eee8d4;
    border-left-color: #eee8d4;
    border-bottom-color: #5a5040;
    border-right-color: #5a5040;
}

QPushButton:pressed {
    background-color: #b0a890;
    border-top-color: #6b6050;
    border-left-color: #6b6050;
    border-bottom-color: #ddd8c4;
    border-right-color: #ddd8c4;
    padding-top: 6px;
    padding-left: 13px;
}

QPushButton:disabled {
    background-color: #d6d0c0;
    color: #a09888;
    border-color: #b0a898;
    border-top-color: #d6d0c0;
    border-left-color: #d6d0c0;
    border-bottom-color: #b0a898;
    border-right-color: #b0a898;
}

/* QGroupBox items used for the 'cards' on the vital sign tool pages. */
QGroupBox {
    background-color: #f4f1e8;
    border: 1px solid #8b8067;
    border-radius: 4px;
    margin-top: 10px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    background-color: #f4f1e8;
    color: #556b2f;
}

/* Add to dm_styles.qss. Replaces the default checkmark glyph with a
   solid-fill indicator, consistent with the solid-fill selection style
   already used elsewhere (e.g. QTableView::item:selected). */

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #8b8067;
    border-radius: 3px;
    background-color: #f5f5f0;
}

QCheckBox::indicator:hover {
    border-color: #556b2f;
}

QCheckBox::indicator:checked {
    background-color: #556b2f;
    border-color: #556b2f;
}

QCheckBox::indicator:checked:hover {
    background-color: #6b8e23;
}

/* ---------------------------------------------------------------------
   Menu bar: separator line beneath it, and hover highlighting on both
   top-level menus (File/Help) and their dropdown items.
--------------------------------------------------------------------- */
QMenuBar {
    background-color: #e7e2d3;
    border-bottom: 1px solid #8b8067;
    padding: 2px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #c7bea8;
}

QMenu {
    background-color: #f4f1e8;
    border: 1px solid #8b8067;
}

QMenu::item {
    padding: 5px 20px;
}

QMenu::item:selected {
    background-color: #556b2f;
    color: white;
}

QMenu::separator {
    height: 1px;
    background: #8b8067;
    margin: 4px 6px;
}

/* ---------------------------------------------------------------------
   Tree widget (cruise year / dump navigation): hover highlight while
   the mouse is over an item, and a clearly distinct highlight for
   whichever dump is currently selected/loaded into the form.
--------------------------------------------------------------------- */
QTreeWidget::item {
    padding: 3px 4px;
    border-radius: 3px;
}

QTreeWidget::item:hover {
    background-color: #c7bea8;
}

QTreeWidget::item:selected {
    background-color: #556b2f;
    color: white;
}

QTreeWidget::item:selected:hover {
    background-color: #6b8e23;
}
